# Copy to .env and fill in your values. Never commit secrets.

# Option A: Serper.dev (Google Search) — https://serper.dev
SERPER_API_KEY=

# Option B: Tavily — https://tavily.com
TAVILY_API_KEY=

# Option C: Self-hosted SearXNG — https://searxng.github.io/searxng/
SEARXNG_BASE_URL=
# SEARXNG_LANGUAGE=en-US
# SEARXNG_CATEGORIES=general
# SEARXNG_ENGINES=google,bing
# SEARXNG_TIME_RANGE=day
# SEARXNG_SAFESEARCH=1
# SEARXNG_USER_AGENT=
# SEARXNG_HEADERS_JSON={"Authorization":"Bearer ..."}
# SEARXNG_TIMEOUT_SECONDS=30

# ── Optional API tokens ───────────────────────────────────────────────────
# GitHub token (recommended — increases rate limits for GitHub Issues handler)
GITHUB_TOKEN=


#option D  : SerpAPI (Google Search) - https://serpapi.com
SERPAPI_API_KEY=

# StackExchange API key (recommended — increases API quota)
STACKEXCHANGE_KEY=
STACKEXCHANGE_FILTER=withbody

# ── Output limits ─────────────────────────────────────────────────────────
STACKEXCHANGE_MAX_CHARS=20000
GITHUB_MAX_CHARS=20000
GITHUB_MAX_COMMENTS=50
WIKIPEDIA_MAX_CHARS=50000
ARXIV_MAX_CHARS=50000

# ── Polite API identification (recommended for Wikipedia & arXiv) ─────────
WIKIPEDIA_USER_AGENT=mcp-web-search/1.0 (contact: yourmail@example.com)
ARXIV_USER_AGENT=mcp-web-search/1.0 (contact: yourmail@example.com)

# ── Server / transport ────────────────────────────────────────────────────
FASTMCP_HOST=127.0.0.1
FASTMCP_PORT=8000

# ── Logging (stderr only — never stdout, keeps stdio transport clean) ─────
LOG_LEVEL=WARNING

# ── Diagnostics (verbose structured logs + response diagnostics) ──────────
MCP_DIAGNOSTICS=0

# ── Tool timeouts ─────────────────────────────────────────────────────────
TOOL_TOTAL_TIMEOUT_SECONDS=120
TOOL_TOTAL_TIMEOUT_MAX_SECONDS=600
WEB_SEARCH_MAX_CONCURRENCY=3


# Allow running stdio transport from a TTY (only for debugging)
MCP_ALLOW_TTY_STDIO=0
